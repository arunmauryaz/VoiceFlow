<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VoiceFlow.App"
             xmlns:local="using:VoiceFlow"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Flow Design System Color Tokens (01 - Design System) -->
        <Color x:Key="CanvasBgColor">#F9F9F8</Color>
        <Color x:Key="SurfaceColor">#FFFFFF</Color>
        <Color x:Key="SubtleColor">#F4F4F2</Color>
        <Color x:Key="BorderSubtleColor">#E5E5E2</Color>
        <Color x:Key="BorderStrongColor">#D0D0CB</Color>
        <Color x:Key="TextPrimaryColor">#18181B</Color>
        <Color x:Key="TextSecondaryColor">#52525B</Color>
        <Color x:Key="TextMutedColor">#A1A1AA</Color>
        <Color x:Key="RecordingDotColor">#E11D48</Color>
        <Color x:Key="RecordingBgColor">#FFF1F2</Color>
        <Color x:Key="RecordingBorderColor">#FECDD3</Color>
        <Color x:Key="ReadyStatusColor">#10B981</Color>
        <Color x:Key="ReadyBgColor">#ECFDF5</Color>
        <Color x:Key="ReadyBorderColor">#A7F3D0</Color>

        <!-- SolidColorBrush Resources -->
        <SolidColorBrush x:Key="CanvasBgBrush" Color="{StaticResource CanvasBgColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
        <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
        <SolidColorBrush x:Key="RecordingDotBrush" Color="{StaticResource RecordingDotColor}" />
        <SolidColorBrush x:Key="RecordingBgBrush" Color="{StaticResource RecordingBgColor}" />
        <SolidColorBrush x:Key="RecordingBorderBrush" Color="{StaticResource RecordingBorderColor}" />
        <SolidColorBrush x:Key="ReadyStatusBrush" Color="{StaticResource ReadyStatusColor}" />
        <SolidColorBrush x:Key="ReadyBgBrush" Color="{StaticResource ReadyBgColor}" />
        <SolidColorBrush x:Key="ReadyBorderBrush" Color="{StaticResource ReadyBorderColor}" />

        <!-- Fluent Control Overrides for Flow Monochrome Minimalist Theme -->
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#27272A" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#09090B" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#27272A" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{StaticResource BorderStrongColor}" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{StaticResource BorderStrongColor}" />
        <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource BorderSubtleColor}" />
        <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource BorderSubtleColor}" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#FFFFFF" />
        <SolidColorBrush x:Key="RadioButtonForeground" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="RadioButtonForegroundPointerOver" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="RadioButtonForegroundPressed" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="RadioButtonForegroundDisabled" Color="{StaticResource TextMutedColor}" />

        <!-- Vector Icon Geometries (Filled primitives) -->
        <StreamGeometry x:Key="IconWaveform">M 1,6 C 1,5.4 1.4,5 2,5 C 2.6,5 3,5.4 3,6 V 10 C 3,10.6 2.6,11 2,11 C 1.4,11 1,10.6 1,10 Z M 4.5,3 C 4.5,2.4 4.9,2 5.5,2 C 6.1,2 6.5,2.4 6.5,3 V 13 C 6.5,13.6 6.1,14 5.5,14 C 4.9,14 4.5,13.6 4.5,13 Z M 8,1 C 8,0.4 8.4,0 9,0 C 9.6,0 10,0.4 10,1 V 15 C 10,15.6 9.6,16 9,16 C 8.4,16 8,15.6 8,15 Z M 11.5,3 C 11.5,2.4 11.9,2 12.5,2 C 13.1,2 13.5,2.4 13.5,3 V 13 C 13.5,13.6 13.1,14 12.5,14 C 11.9,14 11.5,13.6 11.5,13 Z M 15,6 C 15,5.4 15.4,5 16,5 C 16.6,5 17,5.4 17,6 V 10 C 17,10.6 16.6,11 16,11 C 15.4,11 15,10.6 15,10 Z</StreamGeometry>
        <StreamGeometry x:Key="IconMic">M 8,2 C 6.9,2 6,2.9 6,4 V 8 C 6,9.1 6.9,10 8,10 C 9.1,10 10,9.1 10,8 V 4 C 10,2.9 9.1,2 8,2 Z M 12,8 C 12,10.2 10.2,12 8,12 C 5.8,12 4,10.2 4,8 H 2 C 2,11 4.2,13.4 7,13.9 V 16 H 9 V 13.9 C 11.8,13.4 14,11 14,8 Z</StreamGeometry>
        <StreamGeometry x:Key="IconHome">M 8,2 L 2,7 V 14 C 2,14.6 2.4,15 3,15 H 6.5 V 10.5 H 9.5 V 15 H 13 C 13.6,15 14,14.6 14,14 V 7 Z</StreamGeometry>
        <StreamGeometry x:Key="IconHistory">M 8,2.5 C 11,2.5 13.5,5 13.5,8 C 13.5,11 11,13.5 8,13.5 C 5,13.5 2.5,11 2.5,8 C 2.5,6.5 3.1,5.1 4.1,4.1 L 2,2 H 6.5 V 6.5 L 5.1,5.1 C 4.4,5.9 4,6.9 4,8 C 4,10.2 5.8,12 8,12 C 10.2,12 12,10.2 12,8 C 12,5.8 10.2,4 8,4 V 2.5 Z M 7.5,5 H 8.5 V 8.2 L 10.7,9.5 L 10.2,10.3 L 7.5,8.7 Z</StreamGeometry>
        <StreamGeometry x:Key="IconSettings">M 8,5 C 6.3,5 5,6.3 5,8 C 5,9.7 6.3,11 8,11 C 9.7,11 11,9.7 11,8 C 11,6.3 9.7,5 8,5 Z M 3.2,7 C 3.2,6.7 3.3,6.3 3.4,6 L 2.1,5 L 3.5,2.6 L 5.1,3.1 C 5.6,2.7 6.2,2.4 6.8,2.2 L 7.1,0.5 H 9.9 L 10.2,2.2 C 10.8,2.4 11.4,2.7 11.9,3.1 L 13.5,2.6 L 14.9,5 L 13.6,6 C 13.7,6.3 13.8,6.7 13.8,7 C 13.8,7.3 13.7,7.7 13.6,8 L 14.9,9 L 13.5,11.4 L 11.9,10.9 C 11.4,11.3 10.8,11.6 10.2,11.8 L 9.9,13.5 H 7.1 L 6.8,11.8 C 6.2,11.6 5.6,11.3 5.1,10.9 L 3.5,11.4 L 2.1,9 L 3.4,8 C 3.3,7.7 3.2,7.3 3.2,7 Z</StreamGeometry>
        <StreamGeometry x:Key="IconAbout">M 8,1.5 C 4.4,1.5 1.5,4.4 1.5,8 C 1.5,11.6 4.4,14.5 8,14.5 C 11,14.5 14.5,11.6 14.5,8 C 14.5,4.4 11.6,1.5 8,1.5 Z M 8,4.5 C 8.6,4.5 9,4.9 9,5.5 C 9,6.1 8.6,6.5 8,6.5 C 7.4,6.5 7,6.1 7,5.5 C 7,4.9 7.4,4.5 8,4.5 Z M 7,8 H 9 V 11.5 H 7 Z</StreamGeometry>
        <StreamGeometry x:Key="IconCopy">M 4,2 H 11 C 12.1,2 13,2.9 13,4 V 5 H 12 V 4 C 12,3.4 11.6,3 11,3 H 4 C 3.4,3 3,3.4 3,4 V 11 C 3,11.6 3.4,12 4,12 H 5 V 13 H 4 C 2.9,13 2,12.1 2,11 V 4 C 2,2.9 2.9,2 4,2 Z M 6,6 H 13 C 14.1,6 15,6.9 15,8 V 14 C 15,15.1 14.1,16 13,16 H 6 C 4.9,16 4,15.1 4,14 V 8 C 4,6.9 4.9,6 6,6 Z M 6,7 C 5.4,7 5,7.4 5,8 V 14 C 5,14.6 5.4,15 6,15 H 13 C 13.6,15 14,14.6 14,14 V 8 C 14,7.4 13.6,7 13,7 Z</StreamGeometry>
        <StreamGeometry x:Key="IconTrash">M 2,4 H 14 V 5 H 2 Z M 3.5,6 H 12.5 V 14 C 12.5,14.6 12.1,15 11.5,15 H 4.5 C 3.9,15 3.5,14.6 3.5,14 Z M 5.5,8 H 6.5 V 13 H 5.5 Z M 7.5,8 H 8.5 V 13 H 7.5 Z M 9.5,8 H 10.5 V 13 H 9.5 Z M 6,2 H 10 V 3 H 6 Z</StreamGeometry>
        <StreamGeometry x:Key="IconCheck">M 13.5,4.5 L 6.5,11.5 L 2.5,7.5 L 3.9,6.1 L 6.5,8.7 L 12.1,3.1 Z</StreamGeometry>
        <StreamGeometry x:Key="IconSparkle">M 8,1 L 9.5,5.5 L 14,7 L 9.5,8.5 L 8,13 L 6.5,8.5 L 2,7 L 6.5,5.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconWarning">M 8,2 L 14.5,13.5 H 1.5 Z M 8,6 C 7.6,6 7.2,6.3 7.2,6.8 L 7.5,9.5 H 8.5 L 8.8,6.8 C 8.8,6.3 8.4,6 8,6 Z M 8,10.5 C 7.6,10.5 7.2,10.9 7.2,11.3 C 7.2,11.7 7.6,12.1 8,12.1 C 8.4,12.1 8.8,11.7 8.8,11.3 C 8.8,10.9 8.4,10.5 8,10.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconChevronDown">M 4,6 L 8,10 L 12,6</StreamGeometry>
        <StreamGeometry x:Key="IconClose">M 4,4 L 12,12 M 12,4 L 4,12</StreamGeometry>
        <StreamGeometry x:Key="IconMoreVertical">M 8,3.5 C 7.4,3.5 7,3.9 7,4.5 C 7,5.1 7.4,5.5 8,5.5 C 8.6,5.5 9,5.1 9,4.5 C 9,3.9 8.6,3.5 8,3.5 Z M 8,7 C 7.4,7 7,7.4 7,8 C 7,8.6 7.4,9 8,9 C 8.6,9 9,8.6 9,8 C 9,7.4 8.6,7 8,7 Z M 8,10.5 C 7.4,10.5 7,10.9 7,11.5 C 7,12.1 7.4,12.5 8,12.5 C 8.6,12.5 9,12.1 9,11.5 C 9,10.9 8.6,10.5 8,10.5 Z</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Global Base Overrides for Flow Look & Feel -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif" />
            <Setter Property="Background" Value="{StaticResource CanvasBgBrush}" />
        </Style>

        <!-- Primary Dark Button (#18181B) -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#09090B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Secondary White Surface Button -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.secondary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#E5E5E2" />
        </Style>

        <!-- Ghost / Flat Action Button -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SubtleBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <!-- Nav Item Button in Sidebar -->
        <Style Selector="Button.navItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.navItem PathIcon">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.navItem TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.navItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SubtleBrush}" />
        </Style>
        <Style Selector="Button.navItem:pointerover PathIcon">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.navItem:pointerover TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.navItem.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SubtleBrush}" />
        </Style>
        <Style Selector="Button.navItem.active PathIcon">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.navItem.active TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- White Card Container -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <!-- Keycap Pill -->
        <Style Selector="Border.keycap">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.keycap">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <!-- Section Headers (Caps, muted) -->
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="LetterSpacing" Value="0.5" />
        </Style>

        <!-- Setting Row Title & Description -->
        <Style Selector="TextBlock.settingTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.settingDesc">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- ComboBox Styling -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="12,7" />
        </Style>

        <!-- TextBox Styling -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <!-- RadioButton Styling -->
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13.5" />
        </Style>
        <Style Selector="RadioButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
    </Application.Styles>
</Application>