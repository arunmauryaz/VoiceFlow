<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VoiceFlow.ViewModels"
             x:Class="VoiceFlow.Views.SettingsView"
             x:Name="RootSettings"
             x:DataType="vm:MainWindowViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,48" Spacing="24">

            <!-- PAGE HEADER -->
            <StackPanel Spacing="4">
                <TextBlock Text="Settings"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Configure activation shortcuts, transcription models, and desktop behavior."
                           FontSize="13.5"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- 1. GENERAL SECTION -->
            <StackPanel Spacing="16">
                <TextBlock Text="GENERAL" Classes="sectionHeader" />

                <!-- Run in Background -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Run in background" Classes="settingTitle" />
                        <TextBlock Text="Keep VoiceFlow active in the system tray when closing the window." Classes="settingDesc" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="{Binding RunInBackground}"
                                  OnContent="" OffContent=""
                                  VerticalAlignment="Center" />
                </Grid>

                <!-- Start with Windows -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Start with Windows" Classes="settingTitle" />
                        <TextBlock Text="Automatically launch VoiceFlow minimized upon logging in." Classes="settingDesc" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="{Binding StartWithWindows}"
                                  OnContent="" OffContent=""
                                  VerticalAlignment="Center" />
                </Grid>

                <!-- Show Recording Overlay -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Show recording overlay" Classes="settingTitle" />
                        <TextBlock Text="Display the floating HUD widget on screen during dictation." Classes="settingDesc" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="{Binding ShowOverlay}"
                                  OnContent="" OffContent=""
                                  VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" />

            <!-- 2. MICROPHONE SECTION -->
            <StackPanel Spacing="16">
                <TextBlock Text="MICROPHONE" Classes="sectionHeader" />

                <!-- Input Device -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Input device" Classes="settingTitle" />
                        <TextBlock Text="Select the physical microphone used for voice capture." Classes="settingDesc" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AudioDevices}"
                              SelectedItem="{Binding SelectedAudioDevice}"
                              MinWidth="240" MaxWidth="360"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                </Grid>

                <!-- Microphone Status -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Microphone status" Classes="settingTitle" />
                        <TextBlock Text="Live check of audio stream input levels." Classes="settingDesc" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Classes="secondary"
                                Command="{Binding ToggleMicrophoneTestCommand}">
                            <Panel>
                                <TextBlock Text="Test microphone" FontSize="13" IsVisible="{Binding !IsTestingMic}" />
                                <TextBlock Text="Stop test" FontSize="13" Foreground="{StaticResource RecordingDotBrush}" IsVisible="{Binding IsTestingMic}" />
                            </Panel>
                        </Button>
                        <Border Background="{StaticResource ReadyBgBrush}"
                                BorderBrush="{StaticResource ReadyBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="10,5"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="7" Height="7" CornerRadius="3.5" Background="{StaticResource ReadyStatusBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Microphone working" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource ReadyStatusBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" />

            <!-- 3. TRANSCRIPTION & GEMINI API SECTION -->
            <StackPanel Spacing="16">
                <TextBlock Text="TRANSCRIPTION &amp; GEMINI API" Classes="sectionHeader" />

                <!-- Provider -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Transcription provider" Classes="settingTitle" />
                        <TextBlock Text="Backend service executing speech-to-text inference." Classes="settingDesc" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableProviders}"
                              SelectedItem="{Binding SelectedProvider}"
                              MinWidth="240" MaxWidth="360"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                </Grid>

                <!-- Model -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Transcription model" Classes="settingTitle" />
                        <TextBlock Text="Ultra low-latency multilingual transcription model." Classes="settingDesc" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableModels}"
                              SelectedItem="{Binding SelectedModel}"
                              MinWidth="240" MaxWidth="360"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                </Grid>

                <!-- API Key -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Gemini API Key" Classes="settingTitle" />
                        <TextBlock Text="Stored securely on this device via Windows DPAPI. Never sent elsewhere." Classes="settingDesc" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" MinWidth="260" MaxWidth="380" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox Grid.Column="0"
                                     Text="{Binding ApiKeyInput, Mode=TwoWay}"
                                     PasswordChar="{Binding ApiKeyPasswordChar}"
                                     Watermark="Paste Gemini API Key (AIzaSy...)"
                                     VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Classes="ghost"
                                    Margin="4,0,0,0"
                                    Padding="6,6"
                                    ToolTip.Tip="Reveal / Mask Key"
                                    Command="{Binding ToggleRevealApiKeyCommand}">
                                <TextBlock Text="{Binding RevealButtonIcon}" FontSize="12" />
                            </Button>
                            <!-- Connection Status Badge / Test Button -->
                            <Button Grid.Column="2"
                                    Margin="6,0,0,0"
                                    Classes="secondary"
                                    Command="{Binding TestConnectionCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconCheck}"
                                              Width="12" Height="12"
                                              Foreground="{StaticResource ReadyStatusBrush}"
                                              IsVisible="{Binding HasSavedApiKey}" />
                                    <TextBlock Text="{Binding TestConnectionButtonText}"
                                               FontSize="12.5"
                                               FontWeight="Medium" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="{Binding ConnectionStatusMessage}"
                                   FontSize="12"
                                   Foreground="{Binding ConnectionStatusColor}"
                                   IsVisible="{Binding ConnectionStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   TextWrapping="Wrap" />

                        <!-- Quick Actions: Get API Key & Clear Key -->
                        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right" Margin="0,2,0,0">
                            <Button Classes="ghost"
                                    Padding="0"
                                    Command="{Binding OpenAiStudioCommand}"
                                    ToolTip.Tip="Open Google AI Studio in your browser to get a free Gemini API key">
                                <TextBlock Text="Get Free API Key ↗"
                                           FontSize="12"
                                           Foreground="{StaticResource BrandGradientEnd}"
                                           TextDecorations="Underline" />
                            </Button>
                            <Border Width="1" Height="10" Background="{StaticResource BorderSubtleBrush}" VerticalAlignment="Center"
                                    IsVisible="{Binding HasSavedApiKey}" />
                            <Button Classes="ghost"
                                    Padding="0"
                                    Command="{Binding ClearApiKeyCommand}"
                                    IsVisible="{Binding HasSavedApiKey}"
                                    ToolTip.Tip="Remove your saved API key from this computer">
                                <TextBlock Text="Clear Key"
                                           FontSize="12"
                                           Foreground="{StaticResource RecordingDotBrush}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" />

            <!-- 4. SHORTCUT SECTION -->
            <StackPanel Spacing="16">
                <TextBlock Text="SHORTCUT" Classes="sectionHeader" />

                <!-- Clean Shortcut Configuration Card -->
                <Border Classes="card" Padding="20,18">
                    <StackPanel Spacing="14">
                        <!-- Header Row -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Voice Typing Shortcut" Classes="settingTitle" />
                                <TextBlock Text="Click any box below, then press that key. Fill 1–3 boxes to build your shortcut." Classes="settingDesc" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="secondary"
                                    Content="Reset Default"
                                    ToolTip.Tip="Reset to default (Ctrl + Space)"
                                    Command="{Binding ResetDefaultShortcutCommand}"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <!-- 3-Box Slot Builder Row -->
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8">

                            <!-- Slot 1 -->
                            <Border Width="130" Height="58"
                                    CornerRadius="10"
                                    BorderThickness="1.5"
                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                    Background="{StaticResource SurfaceBrush}">
                                <Panel>
                                    <!-- Idle State (Visible when NOT recording Slot 1) -->
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsRecordingSlot1}">
                                        <Button Grid.Column="0"
                                                Classes="ghost"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Command="{Binding RecordSlot1Command}"
                                                Cursor="Hand"
                                                ToolTip.Tip="Click to set Key 1">
                                            <Panel>
                                                <TextBlock Text="+ Add Key"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !HasSlot1Key}" />
                                                <TextBlock Text="{Binding Slot1Text}"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding HasSlot1Key}" />
                                            </Panel>
                                        </Button>
                                        <Button Grid.Column="1"
                                                Classes="ghost"
                                                Padding="8,0"
                                                VerticalAlignment="Stretch"
                                                VerticalContentAlignment="Center"
                                                Command="{Binding ClearSlot1Command}"
                                                Cursor="Hand"
                                                ToolTip.Tip="Clear Key 1"
                                                IsVisible="{Binding HasSlot1Key}">
                                            <TextBlock Text="✕" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                        </Button>
                                    </Grid>

                                    <!-- Recording State (Visible ONLY when Slot 1 is actively recording) -->
                                    <Button Classes="ghost"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Command="{Binding CancelRecordingShortcutCommand}"
                                            Cursor="Hand"
                                            ToolTip.Tip="Press any key on your keyboard, or click / press Esc to cancel"
                                            IsVisible="{Binding IsRecordingSlot1}">
                                        <Border CornerRadius="8"
                                                BorderThickness="2"
                                                BorderBrush="#3B82F6"
                                                Background="#EFF6FF"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="8" Height="8" CornerRadius="4" Background="#E11D48" />
                                                <TextBlock Text="Press key..."
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1D4ED8" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </Panel>
                            </Border>

                            <!-- + separator 1→2 -->
                            <TextBlock Text="+"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" />

                            <!-- Slot 2 -->
                            <Border Width="130" Height="58"
                                    CornerRadius="10"
                                    BorderThickness="1.5"
                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                    Background="{StaticResource SurfaceBrush}">
                                <Panel>
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsRecordingSlot2}">
                                        <Button Grid.Column="0"
                                                Classes="ghost"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Command="{Binding RecordSlot2Command}"
                                                Cursor="Hand"
                                                ToolTip.Tip="Click to set Key 2">
                                            <Panel>
                                                <TextBlock Text="+ Add Key"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !HasSlot2Key}" />
                                                <TextBlock Text="{Binding Slot2Text}"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding HasSlot2Key}" />
                                            </Panel>
                                        </Button>
                                        <Button Grid.Column="1"
                                                Classes="ghost"
                                                Padding="8,0"
                                                VerticalAlignment="Stretch"
                                                VerticalContentAlignment="Center"
                                                Command="{Binding ClearSlot2Command}"
                                                Cursor="Hand"
                                                ToolTip.Tip="Clear Key 2"
                                                IsVisible="{Binding HasSlot2Key}">
                                            <TextBlock Text="✕" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                        </Button>
                                    </Grid>

                                    <Button Classes="ghost"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Command="{Binding CancelRecordingShortcutCommand}"
                                            Cursor="Hand"
                                            ToolTip.Tip="Press any key on your keyboard, or click / press Esc to cancel"
                                            IsVisible="{Binding IsRecordingSlot2}">
                                        <Border CornerRadius="8"
                                                BorderThickness="2"
                                                BorderBrush="#3B82F6"
                                                Background="#EFF6FF"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="8" Height="8" CornerRadius="4" Background="#E11D48" />
                                                <TextBlock Text="Press key..."
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1D4ED8" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </Panel>
                            </Border>

                            <!-- + separator 2→3 -->
                            <TextBlock Text="+"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" />

                            <!-- Slot 3 -->
                            <Border Width="130" Height="58"
                                    CornerRadius="10"
                                    BorderThickness="1.5"
                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                    Background="{StaticResource SurfaceBrush}">
                                <Panel>
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsRecordingSlot3}">
                                        <Button Grid.Column="0"
                                                Classes="ghost"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Command="{Binding RecordSlot3Command}"
                                                Cursor="Hand"
                                                ToolTip.Tip="Click to set Key 3">
                                            <Panel>
                                                <TextBlock Text="+ Add Key"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !HasSlot3Key}" />
                                                <TextBlock Text="{Binding Slot3Text}"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding HasSlot3Key}" />
                                            </Panel>
                                        </Button>
                                        <Button Grid.Column="1"
                                                Classes="ghost"
                                                Padding="8,0"
                                                VerticalAlignment="Stretch"
                                                VerticalContentAlignment="Center"
                                                Command="{Binding ClearSlot3Command}"
                                                Cursor="Hand"
                                                ToolTip.Tip="Clear Key 3"
                                                IsVisible="{Binding HasSlot3Key}">
                                            <TextBlock Text="✕" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                        </Button>
                                    </Grid>

                                    <Button Classes="ghost"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Command="{Binding CancelRecordingShortcutCommand}"
                                            Cursor="Hand"
                                            ToolTip.Tip="Press any key on your keyboard, or click / press Esc to cancel"
                                            IsVisible="{Binding IsRecordingSlot3}">
                                        <Border CornerRadius="8"
                                                BorderThickness="2"
                                                BorderBrush="#3B82F6"
                                                Background="#EFF6FF"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="8" Height="8" CornerRadius="4" Background="#E11D48" />
                                                <TextBlock Text="Press key..."
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1D4ED8" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </Panel>
                            </Border>
                        </StackPanel>

                        <!-- Save & Activate Action Button Row -->
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,4,0,2">
                            <!-- Pending Activation: Prominent Primary Button -->
                            <Button Classes="primary"
                                    Command="{Binding SaveAndActivateShortcutCommand}"
                                    IsEnabled="{Binding HasAnySlotKey}"
                                    Padding="18,8"
                                    CornerRadius="8"
                                    Cursor="Hand"
                                    ToolTip.Tip="Save and activate this shortcut"
                                    IsVisible="{Binding !IsShortcutSavedAndActive}">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="13" />
                                    <TextBlock Text="Save &amp; Activate Shortcut" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <!-- Saved & Active: Subtle Confirmation Indicator Button -->
                            <Button Classes="secondary"
                                    Command="{Binding SaveAndActivateShortcutCommand}"
                                    Padding="14,7"
                                    CornerRadius="8"
                                    Cursor="Hand"
                                    ToolTip.Tip="This shortcut is currently active and ready to use. Click to re-verify."
                                    IsVisible="{Binding IsShortcutSavedAndActive}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ReadyStatusBrush}" />
                                    <TextBlock Text="Shortcut Active" FontSize="12" FontWeight="Medium" Foreground="{StaticResource ReadyStatusBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Active shortcut label & feedback -->
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Active:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <Border Classes="keycap"
                                        IsVisible="{Binding ShortcutModifierKeyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding ShortcutModifierKeyText}" Classes="keycap" />
                                </Border>
                                <TextBlock Text="+"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           IsVisible="{Binding ShortcutModifierKeyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <Border Classes="keycap">
                                    <TextBlock Text="{Binding ShortcutMainKeyText}" Classes="keycap" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding ShortcutStatusFeedback}"
                                       FontSize="12"
                                       Foreground="{Binding ShortcutStatusColor}"
                                       HorizontalAlignment="Center"
                                       IsVisible="{Binding ShortcutStatusFeedback, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <!-- Escape hint when recording -->
                        <TextBlock Text="Press any key on your keyboard to set (or click / Esc to cancel)"
                                   FontSize="12"
                                   Foreground="#3B82F6"
                                   HorizontalAlignment="Center"
                                   IsVisible="{Binding IsRecordingAnySlot}" />
                    </StackPanel>
                </Border>

                <!-- Activation Mode: Hold vs Toggle -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Activation mode" Classes="settingTitle" />
                        <TextBlock Text="Choose between press-and-hold or click to start/stop." Classes="settingDesc" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton GroupName="ActivationModeGroup"
                                     Content="Hold to talk"
                                     IsChecked="{Binding IsHoldToTalk}" />
                        <RadioButton GroupName="ActivationModeGroup"
                                     Content="Toggle"
                                     IsChecked="{Binding IsToggleToTalk}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" />

            <!-- 5. TEXT INSERTION SECTION -->
            <StackPanel Spacing="16">
                <TextBlock Text="TEXT INSERTION" Classes="sectionHeader" />

                <!-- Auto Paste -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Automatically paste transcription" Classes="settingTitle" />
                        <TextBlock Text="Pastes converted text directly into the focused application window." Classes="settingDesc" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="{Binding AutoPaste}"
                                  OnContent="" OffContent=""
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />
                </Grid>

                <!-- Preserve Clipboard -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Preserve clipboard" Classes="settingTitle" />
                        <TextBlock Text="Restores previous clipboard contents after pasting dictation." Classes="settingDesc" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="{Binding PreserveClipboard}"
                                  OnContent="" OffContent=""
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" />

            <!-- 6. AI CLEANUP SECTION -->
            <StackPanel Spacing="16">
                <TextBlock Text="AI CLEANUP" Classes="sectionHeader" />

                <!-- Clean up transcription -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Clean up transcription" Classes="settingTitle" />
                        <TextBlock Text="Automatically removes filler words ('um', 'ah') and corrects casing." Classes="settingDesc" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="{Binding CleanupEnabled}"
                                  OnContent="" OffContent=""
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />
                </Grid>

                <!-- Cleanup mode dropdown -->
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CleanupEnabled}">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Cleanup mode" Classes="settingTitle" />
                        <TextBlock Text="Level of AI post-processing formatting applied to speech." Classes="settingDesc" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailableCleanupModes}"
                              SelectedItem="{Binding SelectedCleanupModeString}"
                              MinWidth="240" MaxWidth="360"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" />

            <!-- 7. APPEARANCE SECTION -->
            <StackPanel Spacing="16">
                <TextBlock Text="APPEARANCE" Classes="sectionHeader" />

                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Application theme" Classes="settingTitle" />
                        <TextBlock Text="Match Windows system personalization or force theme." Classes="settingDesc" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton GroupName="ThemeGroup"
                                     Content="System"
                                     IsChecked="{Binding IsSystemTheme}" />
                        <RadioButton GroupName="ThemeGroup"
                                     Content="Light"
                                     IsChecked="{Binding IsLightTheme}" />
                        <RadioButton GroupName="ThemeGroup"
                                     Content="Dark"
                                     IsChecked="{Binding IsDarkTheme}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
