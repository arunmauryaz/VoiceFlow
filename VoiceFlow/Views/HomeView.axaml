<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VoiceFlow.ViewModels" x:Class="VoiceFlow.Views.HomeView" x:DataType="vm:MainWindowViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,36" Spacing="22">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5">
                    <TextBlock Text="{Binding HomeHeading}" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding HomeSubtitle}" Classes="settingDesc" TextWrapping="Wrap" MaxWidth="530" HorizontalAlignment="Left" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource SubtleBrush}" CornerRadius="8" Padding="10,7" VerticalAlignment="Top" Margin="12,0,0,0">
                    <TextBlock Text="{Binding OutputModeCaption}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
            </Grid>
            <Border Classes="card" Padding="20,14" IsVisible="{Binding NeedsCloudApiKey}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Add your Gemini key to start dictating." Classes="settingTitle" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="Open settings" Classes="secondary" Command="{Binding NavigateToCommand}" CommandParameter="Settings" />
                </Grid>
            </Border>
            <Border Classes="card" Padding="28,32" MinHeight="255">
                <Panel>
                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowHomeReady}">
                        <Border Width="52" Height="52" CornerRadius="16" Background="{StaticResource SubtleBrush}" HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource IconMic}" Width="21" Height="21" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding DictationInstructionTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding DictationInstructionSubtitle}" Classes="settingDesc" TextWrapping="Wrap" TextAlignment="Center" />
                        <Button Content="Start dictation" Classes="primary" Command="{Binding ToggleHomeRecordingCommand}" IsEnabled="{Binding CanStartDictation}" HorizontalAlignment="Center" Margin="0,7,0,0" />
                        <TextBlock Text="Previews here. Use your shortcut to type in another app." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                    <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsListening}">
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" Height="42">
                            <Border Classes="wave" Width="5" Height="{Binding HomeWaveBar1}" CornerRadius="2.5" Background="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Classes="wave" Width="5" Height="{Binding HomeWaveBar2}" CornerRadius="2.5" Background="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Classes="wave" Width="5" Height="{Binding HomeWaveBar3}" CornerRadius="2.5" Background="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Classes="wave" Width="5" Height="{Binding HomeWaveBar4}" CornerRadius="2.5" Background="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Classes="wave" Width="5" Height="{Binding HomeWaveBar5}" CornerRadius="2.5" Background="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding HomeTimerText}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <Button Content="Finish dictation" Classes="primary" Command="{Binding ToggleHomeRecordingCommand}" />
                            <Button Content="Cancel" Classes="secondary" Command="{Binding CancelTestSpeechCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsHeroTranscribing}">
                        <ProgressBar IsIndeterminate="True" Width="140" Height="4" />
                        <TextBlock Text="Finishing your transcript..." Classes="settingTitle" />
                    </StackPanel>
                </Panel>
            </Border>
            <Grid ColumnDefinitions="*,16,*">
                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="7">
                        <TextBlock Text="TRANSCRIPTION" Classes="sectionHeader" FontSize="10" />
                        <TextBlock Text="{Binding CurrentModelText}" Classes="settingTitle" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding HomeEngineStatus}" Classes="settingDesc" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card" Padding="16">
                    <StackPanel Spacing="7">
                        <TextBlock Text="MICROPHONE" Classes="sectionHeader" FontSize="10" />
                        <TextBlock Text="{Binding CurrentMicrophoneText}" Classes="settingTitle" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Change input in Settings" Classes="settingDesc" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Classes="card" Padding="20" IsVisible="{Binding HasLastTranscription}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="YOUR TRANSCRIPT" Classes="sectionHeader" FontSize="10" />
                            <TextBlock Text="{Binding LastTranscriptionTime}" Classes="settingDesc" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Copy" Classes="secondary" Command="{Binding CopyLastTranscriptionCommand}" Padding="12,6" />
                    </Grid>
                    <SelectableTextBlock Text="{Binding LastTranscriptionText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" LineHeight="22" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Content="Diagnostics" Classes="ghost" Command="{Binding ToggleDebugViewCommand}" />
                <Button Content="Open log" Classes="ghost" Command="{Binding OpenLogFileCommand}" />
            </StackPanel>
            <Border Classes="card" IsVisible="{Binding IsDebugViewVisible}" Padding="16">
                <StackPanel Spacing="12">
                    <Button Content="Copy report" Classes="secondary" Command="{Binding CopyDetailedErrorCommand}" HorizontalAlignment="Right" />
                    <TextBox Text="{Binding DetailedErrorSummary}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" MaxHeight="240" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
