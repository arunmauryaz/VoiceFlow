<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VoiceFlow.ViewModels"
        xmlns:models="using:VoiceFlow.Models"
        x:Class="VoiceFlow.Views.RecordingOverlayWindow"
        x:DataType="vm:RecordingOverlayViewModel"
        Title="VoiceFlow Overlay"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SizeToContent="WidthAndHeight"
        Focusable="False">

    <Border Margin="12"
            Padding="18,10"
            CornerRadius="22"
            Background="#E61A1A24"
            BorderBrush="#44FFFFFF"
            BorderThickness="1"
            BoxShadow="0 8 24 0 #66000000">

        <StackPanel Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">

            <!-- STATE INDICATORS -->

            <!-- Recording Dot & Equalizer Bars -->
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:AppState.Recording}}">
                
                <!-- Glowing Recording Dot -->
                <Border Width="12" Height="12"
                        CornerRadius="6"
                        Background="#FF4D4D"
                        BoxShadow="0 0 10 2 #99FF4D4D"
                        VerticalAlignment="Center" />

                <!-- Mini Audio Level Waveform Bars -->
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Border Width="3" Height="{Binding LevelBar1}" CornerRadius="1.5" Background="#FF6B6B" VerticalAlignment="Center" />
                    <Border Width="3" Height="{Binding LevelBar2}" CornerRadius="1.5" Background="#FF4D4D" VerticalAlignment="Center" />
                    <Border Width="3" Height="{Binding LevelBar3}" CornerRadius="1.5" Background="#FF4D4D" VerticalAlignment="Center" />
                    <Border Width="3" Height="{Binding LevelBar4}" CornerRadius="1.5" Background="#FF6B6B" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- Transcribing Indicator -->
            <Border Width="14" Height="14"
                    CornerRadius="7"
                    BorderBrush="#38BDF8"
                    BorderThickness="2"
                    VerticalAlignment="Center"
                    BoxShadow="0 0 8 1 #8838BDF8"
                    IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:AppState.Transcribing}}" />

            <!-- Cleaning Indicator -->
            <TextBlock Text="✦"
                       FontSize="15"
                       Foreground="#A855F7"
                       VerticalAlignment="Center"
                       IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:AppState.Cleaning}}" />

            <!-- Success Checkmark -->
            <TextBlock Text="✓"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#22C55E"
                       VerticalAlignment="Center"
                       IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:AppState.Success}}" />

            <!-- Error Cross -->
            <TextBlock Text="✕"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="#EF4444"
                       VerticalAlignment="Center"
                       IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:AppState.Error}}" />

            <!-- Status Text -->
            <TextBlock Text="{Binding StatusText}"
                       FontSize="13.5"
                       FontWeight="Medium"
                       Foreground="#F1F5F9"
                       VerticalAlignment="Center" />

            <!-- Duration Timer (only during recording) -->
            <Border Background="#26FFFFFF"
                    CornerRadius="6"
                    Padding="6,2"
                    VerticalAlignment="Center"
                    IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:AppState.Recording}}">
                <TextBlock Text="{Binding DurationText}"
                           FontSize="12"
                           FontFamily="Consolas, monospace"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"
                           VerticalAlignment="Center" />
            </Border>

        </StackPanel>
    </Border>
</Window>
