<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VoiceFlow.ViewModels"
        xmlns:views="using:VoiceFlow.Views"
        x:Class="VoiceFlow.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="avares://VoiceFlow/Assets/app-icon.ico"
        Title="VoiceFlow — Voice Typing"
        Width="1000" Height="680"
        MinWidth="850" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBgBrush}">

    <Grid ColumnDefinitions="220,*">

        <!-- ============================================== -->
        <!-- LEFT NAVIGATION SIDEBAR                        -->
        <!-- ============================================== -->
        <Border Grid.Column="0"
                Background="{StaticResource CanvasBgBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

                <!-- Brand Header -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            Margin="24,26,20,24"
                            VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" ClipToBounds="True">
                        <Image Source="avares://VoiceFlow/Assets/logo.png"
                               Width="28" Height="28" />
                    </Border>
                    <TextBlock Text="VoiceFlow"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Primary Nav Group -->
                <StackPanel Grid.Row="1" Spacing="4" Margin="14,0,14,0">
                    <!-- Home -->
                    <Button Classes="navItem"
                            Classes.active="{Binding IsHomeSelected}"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="Home"
                            AutomationProperties.Name="NavHome">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource IconHome}" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="Home" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- History -->
                    <Button Classes="navItem"
                            Classes.active="{Binding IsHistorySelected}"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="History"
                            AutomationProperties.Name="NavHistory">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource IconHistory}" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="History" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Settings -->
                    <Button Classes="navItem"
                            Classes.active="{Binding IsSettingsSelected}"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="Settings"
                            AutomationProperties.Name="NavSettings">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource IconSettings}" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Divider -->
                <Rectangle Grid.Row="2"
                           Height="1"
                           Fill="{StaticResource BorderSubtleBrush}"
                           Margin="20,16" />

                <!-- Secondary Nav Group -->
                <StackPanel Grid.Row="3" Margin="14,0,14,0">
                    <!-- About -->
                    <Button Classes="navItem"
                            Classes.active="{Binding IsAboutSelected}"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="About"
                            AutomationProperties.Name="NavAbout">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource IconAbout}" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="About" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Spacer -->
                <Panel Grid.Row="4" />

                <!-- Footer Status & Version -->
                <StackPanel Grid.Row="5" Margin="20,0,20,20" Spacing="4">
                    <!-- Dynamic Status Pill -->
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Border Width="7" Height="7"
                                CornerRadius="3.5"
                                Background="{StaticResource ReadyStatusBrush}"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !IsListening}" />
                        <Border Width="7" Height="7"
                                CornerRadius="3.5"
                                Background="{StaticResource RecordingDotBrush}"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsListening}" />
                        <TextBlock Text="Ready"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding !IsListening}" />
                        <TextBlock Text="Listening..."
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource RecordingDotBrush}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsListening}" />
                    </StackPanel>

                    <TextBlock Text="VoiceFlow for Windows v1.0.0"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- MAIN CONTENT AREA                              -->
        <!-- ============================================== -->
        <Panel Grid.Column="1" Background="{StaticResource CanvasBgBrush}">
            <views:HomeView IsVisible="{Binding IsHomeSelected}" />
            <views:HistoryView IsVisible="{Binding IsHistorySelected}" />
            <views:SettingsView IsVisible="{Binding IsSettingsSelected}" />
            <views:AboutView IsVisible="{Binding IsAboutSelected}" />
        </Panel>

    </Grid>
</Window>
