<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VoiceFlow.ViewModels"
        xmlns:models="using:VoiceFlow.Models"
        x:Class="VoiceFlow.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app-icon.ico"
        Title="VoiceFlow — Voice Typing"
        Width="600" Height="780"
        MinWidth="520" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SystemRegionBrush}">

    <Window.Styles>
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Margin" Value="0,18,0,8" />
            <Setter Property="LetterSpacing" Value="1.2" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#4F46E5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,7" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,7" />
        </Style>
    </Window.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,28" Spacing="4">

            <!-- HEADER / HERO -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <StackPanel Grid.Column="0" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="VoiceFlow" FontSize="22" FontWeight="Bold" />
                        <Border Background="#1E1B4B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="v1.0" FontSize="11" FontWeight="Bold" Foreground="#818CF8" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Lightweight Windows voice-to-text utility" FontSize="12.5" Foreground="#64748B" />
                </StackPanel>

                <!-- Status Pill -->
                <Border Grid.Column="1"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="14,6"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusDisplay}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{Binding StatusColor}" />
                </Border>
            </Grid>

            <!-- QUICK SUMMARY CARD -->
            <Border Classes="card">
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                        <TextBlock Text="SHORTCUT" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock Text="{Binding CurrentShortcutText}" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                        <TextBlock Text="MICROPHONE" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock Text="{Binding CurrentMicrophoneText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
                        <TextBlock Text="MODEL" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock Text="{Binding CurrentModelText}" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- INTERACTIVE VOICE TYPING PLAYGROUND -->
            <TextBlock Text="INTERACTIVE TESTING PLAYGROUND" Classes="sectionHeader" />
            <Border Classes="card" BorderBrush="#4F46E5" BorderThickness="1.5">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Test Dictation &amp; Live Transcription" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding TestSpeechStatus}" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Timer badge when recording -->
                        <Border Grid.Column="1"
                                Background="#1E1B4B"
                                CornerRadius="6"
                                Padding="8,4"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsRecordingTestSpeech}">
                            <TextBlock Text="{Binding TestSpeechDuration}"
                                       FontFamily="Consolas, monospace"
                                       FontWeight="Bold"
                                       Foreground="#818CF8" />
                        </Border>
                    </Grid>

                    <!-- Dynamic audio level meter when recording -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsRecordingTestSpeech}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="● Listening..." Foreground="#EF4444" FontWeight="SemiBold" FontSize="12" />
                            <ProgressBar Grid.Column="1"
                                         Margin="12,0"
                                         Minimum="0" Maximum="1"
                                         Value="{Binding TestAudioLevel}"
                                         Height="8"
                                         VerticalAlignment="Center"
                                         CornerRadius="4"
                                         Foreground="#EF4444" />
                            <TextBlock Grid.Column="2" Text="{Binding CurrentMicrophoneText}" FontSize="11" Foreground="#64748B" />
                        </Grid>
                    </StackPanel>

                    <!-- Button Action Bar -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <!-- 1. Idle State: Start Dictation Button -->
                        <Button Classes="primary"
                                IsVisible="{Binding !IsRecordingTestSpeech}"
                                IsEnabled="{Binding !IsTranscribingTestSpeech}"
                                Command="{Binding StartTestSpeechCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🎙️" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="Start Speaking" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- 2. Recording State: Finish Button -->
                        <Button Background="#10B981"
                                Foreground="White"
                                FontWeight="SemiBold"
                                CornerRadius="6"
                                Padding="16,8"
                                IsVisible="{Binding IsRecordingTestSpeech}"
                                Command="{Binding FinishTestSpeechCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="⏹️" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="Finish &amp; Transcribe" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Cancel Button during recording -->
                        <Button Classes="secondary"
                                Content="Cancel"
                                IsVisible="{Binding IsRecordingTestSpeech}"
                                Command="{Binding CancelTestSpeechCommand}" />

                        <!-- Transcribing Indicator -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                    IsVisible="{Binding IsTranscribingTestSpeech}">
                            <Border Width="12" Height="12" CornerRadius="6" BorderBrush="#38BDF8" BorderThickness="2" />
                            <TextBlock Text="Transcribing with Gemini API..." Foreground="#38BDF8" FontWeight="Medium" FontSize="13" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Transcription Result Box -->
                    <StackPanel Spacing="8" IsVisible="{Binding HasTestResult}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="TRANSCRIPTION RESULT" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                            <TextBlock Grid.Column="1" Text="{Binding TestSpeechLatencyInfo}" FontSize="11" Foreground="#10B981" />
                        </Grid>
                        <TextBox Text="{Binding TestTranscriptionResult}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="70"
                                 MaxHeight="180"
                                 FontSize="13.5"
                                 CornerRadius="6"
                                 Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Classes="secondary"
                                    Content="📋 Copy to Clipboard"
                                    Command="{Binding CopyTestTranscriptionCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- TRANSCRIPTION & API SECTION -->
            <TextBlock Text="TRANSCRIPTION &amp; API" Classes="sectionHeader" />
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Grid.Column="0" Text="Provider" VerticalAlignment="Center" FontWeight="Medium" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableProviders}"
                                  SelectedItem="{Binding SelectedProvider}"
                                  HorizontalAlignment="Stretch" />
                    </Grid>

                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Grid.Column="0" Text="Gemini Model" VerticalAlignment="Center" FontWeight="Medium" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableModels}"
                                  SelectedItem="{Binding SelectedModel}"
                                  HorizontalAlignment="Stretch" />
                    </Grid>

                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Grid.Column="0" Text="API Key" VerticalAlignment="Center" FontWeight="Medium" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding ApiKeyInput, Mode=TwoWay}"
                                 PasswordChar="•"
                                 Watermark="Enter Google Gemini API Key" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <Button Classes="primary"
                                Content="Save API Key"
                                Command="{Binding SaveApiKeyCommand}" />
                        <Button Classes="secondary"
                                Content="{Binding IsTestingConnection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=True, FallbackValue='Test Connection'}"
                                Command="{Binding TestConnectionCommand}"
                                IsEnabled="{Binding !IsTestingConnection}" />
                    </StackPanel>

                    <!-- Connection Status Feedback -->
                    <TextBlock Text="{Binding ConnectionStatusMessage}"
                               FontSize="12.5"
                               FontWeight="Medium"
                               Foreground="{Binding ConnectionStatusColor}"
                               IsVisible="{Binding ConnectionStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <!-- MICROPHONE SECTION -->
            <TextBlock Text="MICROPHONE" Classes="sectionHeader" />
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="140,*,Auto">
                        <TextBlock Grid.Column="0" Text="Input Device" VerticalAlignment="Center" FontWeight="Medium" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AudioDevices}"
                                  SelectedItem="{Binding SelectedAudioDevice}"
                                  HorizontalAlignment="Stretch" />
                        <Button Grid.Column="2"
                                Content="⟳"
                                ToolTip.Tip="Refresh audio devices"
                                Margin="8,0,0,0"
                                Command="{Binding RefreshAudioDevices}" />
                    </Grid>

                    <!-- Mic Test Bar -->
                    <Grid ColumnDefinitions="140,*,Auto">
                        <TextBlock Grid.Column="0" Text="Input Level" VerticalAlignment="Center" FontWeight="Medium" />
                        <ProgressBar Grid.Column="1"
                                     Minimum="0" Maximum="1"
                                     Value="{Binding MicTestLevel}"
                                     Height="8"
                                     VerticalAlignment="Center"
                                     CornerRadius="4"
                                     Foreground="#10B981" />
                        <Button Grid.Column="2"
                                Margin="10,0,0,0"
                                Classes="secondary"
                                Content="{Binding IsTestingMic, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=True, FallbackValue='Test Mic'}"
                                Command="{Binding ToggleMicrophoneTestCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SHORTCUT SECTION -->
            <TextBlock Text="GLOBAL SHORTCUT" Classes="sectionHeader" />
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="140,*,Auto">
                        <TextBlock Grid.Column="0" Text="Shortcut Preset" VerticalAlignment="Center" FontWeight="Medium" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding PresetShortcuts}"
                                  SelectedItem="{Binding CurrentShortcutText}"
                                  HorizontalAlignment="Stretch" />
                        <Button Grid.Column="2"
                                Margin="8,0,0,0"
                                Classes="secondary"
                                Content="Apply"
                                Command="{Binding SetPresetShortcutCommand}"
                                CommandParameter="{Binding CurrentShortcutText}" />
                    </Grid>

                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Grid.Column="0" Text="Activation Mode" VerticalAlignment="Center" FontWeight="Medium" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                            <RadioButton Content="Hold to Talk (Recommended)"
                                         IsChecked="{Binding SelectedHotkeyMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:HotkeyActivationMode.HoldToTalk}}" />
                            <RadioButton Content="Toggle"
                                         IsChecked="{Binding SelectedHotkeyMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:HotkeyActivationMode.Toggle}}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding HotkeyRegistrationError}"
                               Foreground="#EF4444"
                               FontSize="12"
                               IsVisible="{Binding HotkeyRegistrationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <!-- AI CLEANUP SECTION -->
            <TextBlock Text="AI TEXT CLEANUP" Classes="sectionHeader" />
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Enable AI Text Cleanup" FontWeight="Medium" />
                            <TextBlock Text="Cleans verbal fillers and refines sentence boundaries" FontSize="11.5" Foreground="#64748B" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding CleanupEnabled}"
                                      OnContent="" OffContent="" />
                    </Grid>

                    <Grid ColumnDefinitions="140,*" IsVisible="{Binding CleanupEnabled}">
                        <TextBlock Grid.Column="0" Text="Cleanup Mode" VerticalAlignment="Center" FontWeight="Medium" />
                        <StackPanel Grid.Column="1" Spacing="8">
                            <RadioButton Content="Clean Transcription (Fixes fillers, stuttering &amp; punctuation)"
                                         IsChecked="{Binding CleanupMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:TextCleanupMode.CleanTranscription}}" />
                            <RadioButton Content="Smart Formatting (Structures dictation into concise lists/paragraphs)"
                                         IsChecked="{Binding CleanupMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:TextCleanupMode.SmartFormatting}}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- BEHAVIOR & SYSTEM SECTION -->
            <TextBlock Text="BEHAVIOR &amp; SYSTEM" Classes="sectionHeader" />
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <CheckBox Content="Automatically paste transcribed text into active window"
                              IsChecked="{Binding AutoPaste}" />

                    <CheckBox Content="Preserve existing clipboard contents before pasting"
                              IsChecked="{Binding PreserveClipboard}" />

                    <CheckBox Content="Show floating recording indicator overlay"
                              IsChecked="{Binding ShowOverlay}" />

                    <CheckBox Content="Keep running in background when closed (minimize to tray)"
                              IsChecked="{Binding RunInBackground}" />

                    <CheckBox Content="Start application with Windows"
                              IsChecked="{Binding StartWithWindows}" />

                    <Grid ColumnDefinitions="140,*" Margin="0,4,0,0">
                        <TextBlock Grid.Column="0" Text="App Theme" VerticalAlignment="Center" FontWeight="Medium" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                            <RadioButton Content="System"
                                         IsChecked="{Binding SelectedTheme, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ThemePreference.System}}" />
                            <RadioButton Content="Dark"
                                         IsChecked="{Binding SelectedTheme, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ThemePreference.Dark}}" />
                            <RadioButton Content="Light"
                                         IsChecked="{Binding SelectedTheme, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ThemePreference.Light}}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- PRIVACY & ABOUT SECTION -->
            <TextBlock Text="PRIVACY" Classes="sectionHeader" />
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Text="Your privacy is fully protected:" FontWeight="SemiBold" FontSize="12.5" />
                    <TextBlock Text="• Microphone audio is processed in-memory and deleted immediately after transcription."
                               FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                    <TextBlock Text="• No telemetry, background tracking, analytics, or third-party servers."
                               FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                    <TextBlock Text="• API keys are encrypted using native Windows DPAPI (ProtectedData)."
                               FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- SAVE BUTTON -->
            <Button Classes="primary"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,8,0,0"
                    Padding="0,10"
                    FontSize="14"
                    Content="Apply All Settings"
                    Command="{Binding SaveAllSettingsCommand}" />

        </StackPanel>
    </ScrollViewer>
</Window>
