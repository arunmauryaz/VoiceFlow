<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VoiceFlow.ViewModels"
             xmlns:models="using:VoiceFlow.Models"
             x:Class="VoiceFlow.Views.HistoryView" x:DataType="vm:MainWindowViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,36" Spacing="20">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="History" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Your recent dictations, on this device." Classes="settingDesc" />
                </StackPanel>
                <Button Grid.Column="1" Content="Clear history" Classes="secondary" Command="{Binding ClearHistoryCommand}" IsVisible="{Binding HasHistory}" VerticalAlignment="Center" />
            </Grid>
            <Border Classes="card" Padding="28,64" IsVisible="{Binding !HasHistory}">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <PathIcon Data="{StaticResource IconHistory}" Width="28" Height="28" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="A blank page, for now." FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Your next dictation will appear here." Classes="settingDesc" />
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding RecentHistory}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:HistoryItem" x:DataType="models:HistoryItem">
                        <Border Classes="card" Padding="20" Margin="0,0,0,12">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FormattedTime}" Classes="settingDesc" />
                                        <TextBlock Text="·" Classes="settingDesc" />
                                        <TextBlock Text="{Binding WordCount}" Classes="settingDesc" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost" Click="CopyEntry" Tag="{Binding .}" ToolTip.Tip="Copy transcription" Padding="8,5" Content="Copy" />
                                    <Button Grid.Column="2" Classes="ghost" Click="DeleteEntry" Tag="{Binding .}" ToolTip.Tip="Delete entry" Padding="8,5">
                                        <PathIcon Data="{StaticResource IconTrash}" Width="13" Height="13" Foreground="{StaticResource TextMutedBrush}" />
                                    </Button>
                                </Grid>
                                <SelectableTextBlock Text="{Binding FinalText}" FontSize="14" LineHeight="22" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
