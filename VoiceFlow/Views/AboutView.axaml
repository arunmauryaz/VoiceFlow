<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VoiceFlow.ViewModels" x:Class="VoiceFlow.Views.AboutView" x:DataType="vm:MainWindowViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,36" Spacing="24">
            <TextBlock Text="About" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <Border Classes="card" Padding="32">
                <StackPanel Spacing="22">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <Image Source="avares://VoiceFlow/Assets/logo.png" Width="64" Height="64" />
                        <StackPanel Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="VoiceFlow" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Your voice, written." Classes="settingDesc" />
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" />
                    <TextBlock Text="Dictate anywhere with local Whisper and Bark models or Google Gemini." Classes="settingTitle" TextWrapping="Wrap" />
                    <TextBlock Text="Local mode keeps audio on your device. Cloud mode sends audio to Gemini." Classes="settingDesc" TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal">
                        <Button Classes="secondary" Content="Documentation" Command="{Binding OpenDocumentationCommand}" Margin="0,0,10,8" />
                        <Button Classes="secondary" Content="Source code" Command="{Binding OpenGitHubCommand}" Margin="0,0,10,8" />
                    </WrapPanel>
                    <TextBlock Text="{Binding AboutVersionLabel}" Classes="settingDesc" />
                    <TextBlock Text="Bark Clean by Conway Research and NVIDIA · CC BY 4.0" Classes="settingDesc" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
